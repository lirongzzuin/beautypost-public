{
  "buildCommand": "pnpm --filter @beautypost/shared build && pnpm --filter @beautypost/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/apps/api/api/index" }
  ],
  "functions": {
    "apps/api/api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/publish-scheduled", "schedule": "0 9 * * *" },
    { "path": "/api/cron/check-expiry", "schedule": "0 10 * * *" },
    { "path": "/api/cron/reward-streak", "schedule": "0 0 * * 1" }
  ]
}
