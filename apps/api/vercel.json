{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/publish-scheduled", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/check-expiry", "schedule": "0 9 * * *" },
    { "path": "/api/cron/reward-streak", "schedule": "0 0 * * 1" }
  ]
}
