{
  "name": "@beautypost/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "dev:local": "DATABASE_URL=pglite:.data/pglite STORAGE=local AI_PROVIDER=${AI_PROVIDER:-mock} RENDER_WORKER_TOKEN=${RENDER_WORKER_TOKEN:-local-worker-token} tsx watch src/dev.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.131",
    "@beautypost/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@neondatabase/serverless": "^0.10.0",
    "@upstash/qstash": "^2.7.0",
    "@upstash/redis": "^1.34.0",
    "@vercel/blob": "^0.27.0",
    "ai": "^6.0.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "resend": "^4.0.0",
    "zod": "^4.6.5",
    "@beautypost/ai": "workspace:*",
    "@beautypost/caption": "workspace:*",
    "@beautypost/photocraft": "workspace:*",
    "@beautypost/preset": "workspace:*",
    "@beautypost/render": "workspace:*",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.29.0",
    "tsx": "^4.19.0",
    "typescript": "*",
    "vitest": "^3.2.7"
  }
}
