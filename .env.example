# ============================================================================
#  BeautyPost 환경변수 — .env.local 에 복사해서 값을 채우세요
#  [필수] 없으면 핵심 기능이 동작하지 않음 / [선택] 없어도 동작(기능 제한)
# ============================================================================


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  1. 핵심 [필수] — 앱 기본 동작
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Neon Postgres 접속 주소 — https://console.neon.tech → 프로젝트 → Connection string
DATABASE_URL=postgresql://user:password@host/beautypost?sslmode=require

# JWT 서명 키 (각각 32자 이상 랜덤). 생성: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# 크론/내부 호출 보호용 시크릿. 생성: openssl rand -hex 16
CRON_SECRET=

# 서비스 공개 주소 (매직링크·이메일 버튼 링크에 사용)
#   로컬: http://localhost:5173   /   운영: https://beautypost.shop
APP_URL=http://localhost:5173


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  2. 이메일 [필수] — 로그인 매직링크 발송 (Resend)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# https://resend.com/api-keys 에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxx

# 발신 주소. 도메인 인증(resend.com/domains) 완료 후 사용 가능.
#   인증 전 테스트: onboarding@resend.dev (본인 가입 이메일로만 발송)
#   인증 후 운영:   noreply@beautypost.shop
EMAIL_FROM=onboarding@resend.dev


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  3. AI [권장] — 캡션/블로그 생성
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# [권장·무료] Google Gemini 무료 티어 — https://aistudio.google.com/apikey
#   설정하면 캡션 생성이 0원으로 동작 (하루 ~1,500건)
GOOGLE_GENERATIVE_AI_API_KEY=

# 사용 모델 (기본값 그대로 두면 됨). 더 가벼운 무료 대안: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# [선택] 폴백용 Vercel AI Gateway → Claude.
#   운영(Vercel): OIDC 자동. 로컬에서 Gateway로 테스트하려면 키를 넣되,
#   비워둘 땐 빈 문자열("")이 아니라 "줄 자체를 두거나 값 없이" 두세요.
AI_GATEWAY_API_KEY=
AI_FALLBACK_MODEL=anthropic/claude-sonnet-5.5


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  4. 저장소 [필수] — 사진/영상 업로드 (Vercel Blob)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Vercel → Storage → Blob 스토어 생성·연결 시 자동 주입.
#   로컬에서 수동으로 쓰려면 스토어 설정에서 토큰 복사
BLOB_READ_WRITE_TOKEN=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  5. 캐시·큐 [선택] — 요청 제한 / 인스타 보안 / 예약 발행
#     없으면: 레이트리밋·CSRF 건너뜀(동작엔 지장 없음)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Upstash Redis — https://console.upstash.com (REST API 탭)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash — 예약 발행 큐
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  6. 인스타그램 [선택·나중] — 실제 자동 게시 (Meta 앱 심사 필요)
#     없으면: Mock 모드로 동작(실제 게시 X)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# https://developers.facebook.com → 앱 생성 후 발급
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://beautypost.shop/api/channels/instagram/callback


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  7. 로컬 개발 전용 [선택]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 비워두면 Vite 프록시가 /api/* → localhost:3000 으로 전달
VITE_API_URL=
# 서버 내부 자기참조 주소
API_URL=http://localhost:3000
# VERCEL_OIDC_TOKEN 은 `vercel env pull` 시 자동 생성됨 (수동 입력 불필요)
