# ─── Web App (Vite) ─────────────────────────────────────────
# Leave empty in dev — Vite proxy rewrites /api/* to localhost:3000
VITE_API_URL=

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/beautypost?sslmode=require

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-32-chars-minimum-secret
JWT_REFRESH_SECRET=change-me-32-chars-refresh-secret

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=뷰티포스트 <hello@beautypost.kr>
APP_URL=http://localhost:5173

# ─── Storage (Vercel Blob) ──────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxx

# ─── AI ─────────────────────────────────────────────────────
# PRIMARY (free): Google Gemini free tier. Get a key at
#   https://aistudio.google.com/apikey  (genuinely free, ~1,500 req/day)
# When set, caption/blog generation runs on Gemini at zero cost.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#
# FALLBACK: Vercel AI Gateway → Claude (uses Vercel free monthly credits).
# Used automatically when Gemini is absent/rate-limited/errors.
# On Vercel: OIDC is automatic. Locally without OIDC: set AI_GATEWAY_API_KEY.
# Leave AI_GATEWAY_API_KEY UNSET (not empty "") so OIDC can take over.
AI_GATEWAY_API_KEY=
AI_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# ─── Queue (Upstash QStash) ─────────────────────────────────
QSTASH_TOKEN=xxxxxxxxxxxx
QSTASH_CURRENT_SIGNING_KEY=sig_xxxxxxxxxxxx
QSTASH_NEXT_SIGNING_KEY=sig_xxxxxxxxxxxx

# ─── Cache (Upstash Redis) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# ─── Instagram (Meta) ───────────────────────────────────────
# 미확인: Instagram API with Instagram Login vs Facebook Login 방식
# 공식 문서 확인 후 ADR-002에 결정 사항 기록 예정
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/auth/instagram/callback

# ─── Internal ───────────────────────────────────────────────
CRON_SECRET=change-me-cron-secret
API_URL=http://localhost:3000
MEDIA_URL_TTL_SECONDS=3600
