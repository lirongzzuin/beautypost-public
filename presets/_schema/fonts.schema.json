{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "styles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Regular",
          "Medium",
          "Bold"
        ]
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "Regular",
          "Medium",
          "Bold"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "family",
    "license",
    "source",
    "styles",
    "files"
  ]
}
