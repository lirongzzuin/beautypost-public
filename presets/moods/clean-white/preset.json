      "main": { "font": "pretendard", "weight": "Medium", "color": "#222222", "background": "#ffffff", "position": "lower-third" },
      "emphasis": { "font": "pretendard", "weight": "Bold", "color": "#222222", "stroke": "#ffffff", "position": "center" },
      "label": { "font": "pretendard", "weight": "Regular", "color": "#888888", "position": "top", "animation": "none" }
    },
    "music": { "genres": ["acoustic", "lofi"], "bpm": [80, 100], "energy": "low" }
  },
  "copy": { "tone": "calm", "emojiPerParagraph": [0, 1], "sentenceLength": "short" }
}
