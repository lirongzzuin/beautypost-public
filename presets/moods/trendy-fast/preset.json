{
  "$schema": "../../_schema/moods.schema.json",
  "id": "trendy-fast",
  "version": 3,
  "label": "트렌디·빠른 컷",
  "order": 50,
  "description": "선명한 대비와 생동감, 0.5~1초 빠른 컷, 플래시·휩 전환, 굵은 고딕 자막과 펀치줌",
  "palette": {
    "primary": "#111111",
    "accent": "#d7ff3a",
    "background": "#111111",
    "text": "#ffffff"
  },
  "grade": {
    "contrast": 10,
    "vibrance": 10,
    "saturation": 2,
    "highlights": -8
  },
  "photo": {
    "overlay": {
      "font": "black-han-sans",
      "weight": "Regular",
      "color": "#ffffff",
      "stroke": "#111111",
      "position": "center"
    }
  },
  "video": {
    "durationSec": [
      7,
      10
    ],
    "cutSec": [
      0.6,
      1.0
    ],
    "transition": "flash",
    "transitionSec": 0.1,
    "motion": "punch",
    "captions": {
      "main": {
        "font": "pretendard",
        "weight": "Bold",
        "color": "#ffffff",
        "shadow": true,
        "position": "lower-third",
        "animation": "pop"
      },
      "emphasis": {
        "font": "black-han-sans",
        "weight": "Regular",
        "color": "#d7ff3a",
        "stroke": "#111111",
        "position": "center",
        "animation": "pop"
      },
      "label": {
        "font": "pretendard",
        "weight": "Bold",
        "color": "#d7ff3a",
        "shadow": true,
        "position": "top",
        "animation": "none"
      }
    },
    "labelText": {
      "before": "BEFORE",
      "after": "AFTER",
      "process": "ING"
    },
    "watermark": true,
    "music": {
      "genres": [
        "hiphop",
        "edm"
      ],
      "bpm": [
        120,
        140
      ],
      "energy": "high"
    }
  },
  "copy": {
    "tone": "witty",
    "emojiPerParagraph": [
      0,
      1
    ],
    "sentenceLength": "short"
  }
}
