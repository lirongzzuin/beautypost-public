{
  "$schema": "../_schema/policy.schema.json",
  "id": "medical-claims",
  "label": "의료·효과 단정 표현",
  "severity": "block",
  "rules": [
    {
      "match": "부작용\\s*(이\\s*)?(전혀\\s*)?(없|0)",
      "kind": "regex",
      "reason": "부작용이 없다고 단정할 수 없어요",
      "suggest": "시술 전 상담으로 피부 상태를 꼼꼼히 확인해요"
    },
    {
      "match": "100\\s*%",
      "kind": "regex",
      "reason": "효과·만족을 100%로 단정하는 표현",
      "suggest": "많은 분들이 만족하신"
    },
    {
      "match": "평생\\s*(유지|지속|간다|가요|가는)|(?<!반)영구(적|히)?\\s*(유지|지속|효과|보존)?",
      "kind": "regex",
      "reason": "반영구 시술은 시간이 지나면 흐려져요",
      "suggest": "개인차에 따라 1~2년 정도 유지돼요"
    },
    {
      "match": "완치",
      "reason": "의료적 치료 효과 단정",
      "suggest": "관리"
    },
    {
      "match": "치료(효과|됩니다|돼요|해\\s?드)",
      "kind": "regex",
      "reason": "미용 시술은 치료 행위로 표현할 수 없어요",
      "suggest": "관리"
    },
    {
      "match": "통증\\s*(이\\s*)?(전혀\\s*)?없",
      "kind": "regex",
      "reason": "통증은 개인차가 있어요",
      "suggest": "통증을 줄이도록 신경 써서 진행해요"
    },
    {
      "match": "흉터\\s*(가\\s*)?(전혀\\s*)?(없|안\\s*남)",
      "kind": "regex",
      "reason": "흉터 여부를 단정할 수 없어요",
      "suggest": "피부 자극을 줄이는 방식으로 진행해요"
    },
    {
      "match": "의학적으로\\s*(검증|입증)",
      "kind": "regex",
      "reason": "근거 없는 의학적 검증 표현"
    },
    {
      "match": "(재생|회복)\\s*효과",
      "kind": "regex",
      "reason": "의학적 효능 표현"
    }
  ]
}
