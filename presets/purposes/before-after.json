{
  "$schema": "../_schema/purposes.schema.json",
  "id": "before-after", "version": 1, "label": "비포·애프터", "order": 10,
  "description": "시술 전후 변화가 주인공. 결과로 후킹 → 고민 → (과정) → 결과 → 예약",
  "legacyThemes": ["before_after"],
  "requiredMedia": [{ "role": "before", "min": 1, "max": 3 }, { "role": "after", "min": 1, "max": 3 }, { "role": "process", "min": 0, "max": 4 }],
