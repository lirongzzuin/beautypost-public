  "video": { "slots": [
    { "role": "hook", "durationSec": [1.0, 1.5], "source": "media", "mediaRole": "after", "caption": { "intent": "결과를 보여주며 한 줄 후킹", "maxChars": 14 } },
    { "role": "before", "durationSec": [1.5, 3.0], "source": "media", "mediaRole": "before", "caption": { "intent": "시술 전 고객의 고민", "maxChars": 16 } },
    { "role": "process", "durationSec": [2.0, 8.0], "source": "media", "mediaRole": "process", "optional": true, "caption": { "intent": "시술 포인트", "maxChars": 16 } },
    { "role": "after", "durationSec": [2.5, 5.0], "source": "media", "mediaRole": "after", "caption": { "intent": "보이는 변화(사실만)", "maxChars": 16 } },
    { "role": "cta", "durationSec": [2.0, 3.0], "source": "card", "caption": { "intent": "예약 유도 + 샵 이름", "maxChars": 20 } }
  ] },
  "photo": { "layout": "before-after-split" },
